# MexiSol World on Hostinger (Apache / LiteSpeed).
Options -Indexes -MultiViews
DirectoryIndex index.html
# /blog and /es are pages (blog.html, es.html) and also folders of subpages: never add a slash.
DirectorySlash Off
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain (www.mexisol.world -> mexisol.world).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /about.html -> /about (one canonical URL per page).
  RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Trailing slash -> no slash, except the home page and folders.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # The women's retreat is held in Spanish; its page only exists in Spanish.
  RewriteRule ^womens-retreat/?$ /es/retiro-de-mujeres [R=301,L]

  # /sitemap.xml serves the sitemap index (the name most tools expect).
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

  # Clean URLs: /about serves about.html. /blog serves blog.html even though a blog/ folder
  # exists, and so does /blog/ if the server adds the slash itself.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Real security headers (GitHub Pages could not send these).
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Static files: a week (files in /_astro/ get a new name whenever they change).
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|ico|svg|woff2|css|js|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType video/webm .webm
  AddType application/manifest+json .webmanifest
</IfModule>
