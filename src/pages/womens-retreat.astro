---
// Women's Retreat with Araisis at Finca El Péndulo (source: araisis.com/retiro-mujeres).
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSplit from '../components/HeroSplit.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import retreats from '../data/retreats.json';
import { registerHref, absolute } from '../lib/url';
import { event, fincaLocation } from '../lib/schema';

const r = retreats.finca.find((x) => x.id === 'womens-araisis')!;
const included = [
  'Two ceremonies with niños santos (sacred mushrooms)',
  'Live music medicine',
  'Voice activation, cacao and kambo ceremonies',
  'Feminine astrology workshops, in a group and one-on-one, based on your natal chart',
  'Movement, release, sensuality and connection with your body',
  'Self-love rituals and guided meditations',
  'From lineage to freedom',
  'Time in nature, integration and rest',
  'Temazcal',
];
const schema = [event({
  name: "Women's Retreat with Araisis",
  start: r.start,
  end: r.end,
  description: "Dancing between the Earth and the stars: a women's retreat at Finca El Péndulo with Araisis. Two ceremonies with sacred mushrooms, music medicine, cacao, kambo, voice activation, astrology workshops and temazcal.",
  url: absolute('/womens-retreat'),
  location: fincaLocation,
  bookingUrl: r.bookingUrl,
})];
---
<BaseLayout
  title="Women's Retreat at Finca El Péndulo, Nov 2026 | MexiSol World"
  description="A women's retreat with Araisis, November 23-29, 2026, near Guadalajara: sacred mushroom ceremonies, music, cacao, kambo, astrology workshops and temazcal."
  path="/womens-retreat"
  current="finca"
  ogImage="women"
  breadcrumbs={[{ name: 'Finca El Péndulo retreats', path: '/finca-el-pendulo' }, { name: "Women's Retreat", path: '/womens-retreat' }]}
  schema={schema}
>
  <HeroSplit
    image="women-circle-under-palapa"
    imageAlt="A women's circle under the palapa by the lake"
    eyebrow="November 23-29, 2026 · Finca El Péndulo"
    title="Dancing between the Earth and the stars"
    cta={{ label: 'Reserve your place', href: r.bookingUrl }}
    images={[
      { name: 'women-osho-hut-flower-circle', alt: 'Women seated around a circle of flowers in the Osho Hut' },
      { name: 'women-meditation-osho-hut', alt: 'Three women meditating in the Osho Hut' },
    ]}
  >A women's retreat with Araisis to come back to your essence. Six days at Finca El Péndulo, in Tepatitlán de Morelos, Jalisco.</HeroSplit>

  <SectionIntro eyebrow="For women">A safe space of respect, presence and sisterhood. Places are limited.</SectionIntro>

  <div class="photo-row" style="--min:240px;--h:380px">
    <Photo name="women-fire-circle-night" alt="Women dancing around the fire at night" sizes="(max-width: 760px) 100vw, 33vw" widths={[480, 800, 1200]} />
    <Photo name="women-long-dinner" alt="Women sharing a long dinner by candlelight" sizes="(max-width: 760px) 100vw, 33vw" widths={[480, 800, 1200]} />
    <Photo name="women-movement-balloons" alt="Movement and play with red balloons" sizes="(max-width: 760px) 100vw, 33vw" widths={[480, 800, 1200]} />
  </div>

  <section class="section">
    <div class="wrap grid">
      <div>
        <p class="label" style="margin-bottom:var(--space-5)">The experience</p>
        <h2 class="t-heading" style="margin-bottom:var(--space-5)">Six days to return to yourself</h2>
        <p class="muted" style="margin-bottom:var(--space-4)">Ceremony, music and movement, held among women, with time for rest and for the land.</p>
        <p class="muted">Before confirming your place, the Araisis team sets up a short call with you.</p>
      </div>
      <div>
        <h2 class="label" style="margin-bottom:var(--space-5)">What's included</h2>
        <ul class="rule-list">
          {included.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="photo-row" style="--min:320px;--h:460px">
    <Photo name="women-group-portrait" alt="Women together after a retreat" sizes="(max-width: 760px) 100vw, 50vw" widths={[480, 800, 1200]} />
    <Photo name="women-drum-at-night" alt="Drums and dance at night under the palapa" sizes="(max-width: 760px) 100vw, 50vw" widths={[480, 800, 1200]} />
  </div>

  <section id="register" class="section deep center">
    <p class="label" style="margin-bottom:var(--space-5)">Places are limited</p>
    <h2 class="t-heading measure" style="margin-bottom:var(--space-5)">Reserve your place</h2>
    <p class="measure" style="margin-bottom:var(--space-7)">Booking for this retreat is handled by Araisis. Questions first? Write to us and we will put you in touch.</p>
    <div class="cluster">
      <Button href={r.bookingUrl} variant="on-photo" data-track="booking">Reserve on Araisis</Button>
      <Button href={registerHref('womens-araisis')} variant="on-photo" data-track="register">Ask us first</Button>
    </div>
  </section>
</BaseLayout>
