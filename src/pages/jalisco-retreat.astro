<script is:inline src={`${base}/js/site.js?v=${v}`} defer></script>

<script>
  import { startHero, createNightSound } from '../scripts/lp-hero';

  document.documentElement.classList.replace('no-js', 'js');
  const ui = document.getElementById('ui')!;
  const head = document.getElementById('head')!;
  const root = document.documentElement;

  // Hold the page still until the title has landed (only on a fresh load at the top)
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  let unlocked = false;
  const unlock = () => { if (!unlocked) { unlocked = true; root.classList.remove('lp-lock'); } };
  if (!location.hash && window.scrollY < 5 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('lp-lock');
  else unlock();
  let shown = false;
  function showUI() {
    if (shown) return;
    shown = true;
    ui.classList.add('on');
    head.classList.add('on');
    setTimeout(unlock, 1250);
  }
  const loader = document.getElementById('loader')!;
  const scene = document.getElementById('scene')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 3D hero (falls back to a plain dark sky without WebGL)
  let hero: ReturnType<typeof startHero> | null = null;
  try {
    hero = startHero(scene, {
      onLoaded: () => { loader.classList.add('gone'); setTimeout(showUI, 200); },
      onIntroDone: showUI,
    });
  } catch {
    loader.classList.add('gone');
    showUI();
  }
  setTimeout(() => { loader.classList.add('gone'); showUI(); }, 2200);
  setTimeout(unlock, 4000);

  // Menu stays on screen; it gets a dark glass background once you scroll
  const onScroll = () => head.classList.toggle('solid', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // "Is a retreat right for you?": text rises in like the hero, light follows the pointer
  const who = document.getElementById('who')!;
  new IntersectionObserver(([e], o) => { if (e.isIntersecting) { who.classList.add('on'); o.disconnect(); } }, { threshold: 0.2 }).observe(who);
  if (window.matchMedia('(hover: hover)').matches) {
    who.addEventListener('pointermove', (e) => {
      const r = who.getBoundingClientRect();
      who.style.setProperty('--mx', `${e.clientX - r.left}px`);
      who.style.setProperty('--my', `${e.clientY - r.top}px`);
      const li = (e.target as HTMLElement).closest<HTMLElement>('.lp-who__list li');
      if (li) {
        const lr = li.getBoundingClientRect();
        li.style.setProperty('--x', `${e.clientX - lr.left}px`);
        li.style.setProperty('--y', `${e.clientY - lr.top}px`);
      }
    });
  }

  const sound = createNightSound();
  const soundBtn = document.getElementById('sound')!;
  soundBtn.addEventListener('click', () => soundBtn.setAttribute('aria-pressed', String(sound.toggle())));
  const go = document.getElementById('go')!;
  go.addEventListener('pointerenter', () => { hero?.startHoverTransition(); sound.muffle(true); });
  go.addEventListener('pointerleave', () => { hero?.stopHoverTransition(); sound.muffle(false); });

  // Videos load and play only while on screen
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-src]');
  const vo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) {
        if (!v.src) v.src = v.dataset.src!;
        if (!reduced) v.play().catch(() => {});
      } else if (!v.paused) v.pause();
    }
  }, { rootMargin: '200px 0px' });
  vids.forEach((v) => vo.observe(v));

  // Headings: words rise in one by one, like the hero title
  document.querySelectorAll<HTMLElement>('.lp-h2:not(.lp-who__title), .lp-band__line, .lp-final__title').forEach((h) => {
    const text = h.textContent!.trim().replace(/\s+/g, ' ');
    h.setAttribute('aria-label', text);
    h.classList.add('lp-anim');
    h.innerHTML = text.split(' ').map((w, i) => `<span class="lp-w" aria-hidden="true"><span style="--d:${80 + i * 70}ms">${w}</span></span>`).join('');
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { h.classList.add('on'); o.disconnect(); } }, { threshold: 0.4 }).observe(h);
  });

  // Reveal on scroll
  const ro = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
  }, { threshold: 0.15 });
  document.querySelectorAll('[data-reveal]').forEach((el) => ro.observe(el));

  // 3D tilt on cards and media
  if (!reduced && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = `perspective(900px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.02)`;
      });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });
  }

  // Day by day: tabs (click or arrow keys)
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.lp-days__tabs [role=tab]'));
  function selectDay(i: number, focus = false) {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
      panel.hidden = !on;
      if (on) panel.classList.remove('lp-day--in'), void panel.offsetWidth, panel.classList.add('lp-day--in');
    });
    if (focus) tabs[i].focus();
    tabs[i].scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduced ? 'auto' : 'smooth' });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => selectDay(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); selectDay((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); selectDay((i - 1 + tabs.length) % tabs.length, true); }
    });
  });

  // Sticky button appears after the hero
  const sticky = document.querySelector('.lp-sticky')!;
  new IntersectionObserver(([e]) => sticky.classList.toggle('on', !e.isIntersecting)).observe(document.getElementById('top')!);
</script>

<style is:global>
  .lp { --night: #050a08; --cream: #f5efe2; --u: min(calc(100vw / 1600), calc(100vh / 900)); background: var(--surface); }
  .lp a { color: inherit; }
  .lp-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 56px); }

  /* Hero */
  .lp-hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; color: var(--cream); overflow: hidden; }
  .lp-hero__scene { position: fixed; inset: 0; z-index: -1; background: var(--night); }
  .lp-hero__scene canvas { display: block; width: 100% !important; height: 100% !important; }
  .lp-hero__vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 45%, transparent 35%, rgba(0,0,0,.55) 100%), linear-gradient(to bottom, rgba(5,10,8,.5), transparent 25%, transparent 70%, rgba(5,10,8,.7)); }
  .lp-ui { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  html.lp-lock, html.lp-lock body { overflow: hidden; }

  /* Text that rises in (hero and "Is a retreat right for you?") */
  .js .lp-anim .lp-rise { opacity: 0; transform: translateY(26px); filter: blur(10px); transition: opacity .9s ease var(--d, 0ms), transform 1s cubic-bezier(.2,.7,.2,1) var(--d, 0ms), filter .9s ease var(--d, 0ms); }
  .js .lp-anim.on .lp-rise { opacity: 1; transform: none; filter: none; }
  .lp-line { display: block; }
  .lp-w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0 .05em .1em; margin-bottom: -.1em; }
  .lp-w { margin-right: .18em; } .lp-w:last-child { margin-right: 0; }
  .lp-w > span { display: inline-block; }
  .js .lp-anim .lp-w > span { transform: translateY(110%) rotate(5deg); opacity: 0; filter: blur(8px); transition: transform .95s cubic-bezier(.2,.8,.2,1) var(--d, 0ms), opacity .7s ease var(--d, 0ms), filter .8s ease var(--d, 0ms); }
  .js .lp-anim.on .lp-w > span { transform: none; opacity: 1; filter: none; }
  .lp-ui a, .lp-ui button { pointer-events: auto; }
  .lp-head { position: fixed; z-index: 60; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: calc(26 * var(--u)) calc(44 * var(--u)); color: var(--cream); transition: opacity .9s ease, background .4s ease, padding .4s ease, box-shadow .4s ease; }
  .js .lp-head:not(.on) { opacity: 0; pointer-events: none; }
  .lp-head.solid { background: rgba(5,10,8,.82); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); padding-top: 10px; padding-bottom: 10px; box-shadow: 0 1px 0 rgba(245,239,226,.08); }
  .lp-head__logo img { width: calc(150 * var(--u)); min-width: 110px; height: auto; display: block; transition: width .4s ease, min-width .4s ease; }
  .lp-head.solid .lp-head__logo img { width: 92px; min-width: 92px; }
  .lp-head__nav { display: flex; align-items: center; gap: calc(40 * var(--u)); font: 500 calc(14 * var(--u)) / 1 var(--font-text); letter-spacing: .16em; text-transform: uppercase; }
  .lp-head__nav a { text-decoration: none; transition: opacity .2s; }
  .lp-head__nav a:not(.lp-pill):hover { opacity: .6; }
  .lp-pill { display: inline-flex; align-items: center; height: calc(46 * var(--u)); min-height: 38px; padding: 0 calc(26 * var(--u)); border-radius: 99px; background: var(--cream); color: #151510 !important; letter-spacing: .08em; transition: transform .25s; }
  .lp-pill:hover { transform: translateY(-1px); }
  .lp-hero__copy { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-46%); display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 20px; }
  .lp-eyebrow { font: 500 calc(13 * var(--u)) / 1 var(--font-text); letter-spacing: .3em; text-transform: uppercase; opacity: .8; margin-bottom: calc(28 * var(--u)); }
  .lp-hero__title { font: 400 calc(150 * var(--u)) / .92 var(--font-display); letter-spacing: -.02em; text-shadow: 0 2px 40px rgba(0,0,0,.45); }
  .lp-hero__cap { margin-top: calc(40 * var(--u)); font: 400 calc(20 * var(--u)) / 1.4 var(--font-text); text-shadow: 0 1px 18px rgba(0,0,0,.9), 0 0 4px rgba(0,0,0,.8); }
  .lp-hero__copy::before { content: ''; position: absolute; inset: -10% 10%; z-index: -1; background: radial-gradient(ellipse at center, rgba(5,10,8,.55), transparent 70%); pointer-events: none; }
  .lp-go { display: grid; place-items: center; margin-top: calc(34 * var(--u)); width: calc(62 * var(--u)); height: calc(62 * var(--u)); min-width: 48px; min-height: 48px; border: 1.5px solid var(--cream); border-radius: 50%; transition: background .3s, color .3s; }
  .lp-go:hover { background: var(--cream); color: #151510; }
  .lp-go svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .lp-corner { position: absolute; right: calc(44 * var(--u)); bottom: calc(44 * var(--u)); display: flex; align-items: center; gap: 18px; font: 500 calc(12.5 * var(--u)) / 1 var(--font-text); letter-spacing: .16em; text-transform: uppercase; }
  .lp-corner i { width: 1px; height: 26px; background: rgba(245,239,226,.45); }
  .lp-sound { display: grid; place-items: center; width: 32px; height: 32px; background: none; border: 0; color: inherit; cursor: pointer; }
  .lp-sound svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .lp-sound .w { transition: opacity .3s; }
  .lp-sound[aria-pressed=false] .w { opacity: 0; }
  .lp-sound[aria-pressed=true] .x { opacity: 0; }
  .lp-loader { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; background: var(--night); transition: opacity 1s ease; pointer-events: none; }
  .lp-loader.gone { opacity: 0; }
  .lp-loader span { width: 9px; height: 9px; border-radius: 50%; background: var(--brand-ochre); animation: lp-pulse 1.2s ease-in-out infinite; }
  @keyframes lp-pulse { 50% { transform: scale(.4); opacity: .4; } }

  /* Type */
  .lp-label { font: 500 13px/1 var(--font-text); letter-spacing: .32em; text-transform: uppercase; color: var(--label-ink); margin-bottom: 20px; }
  .lp-h2 { font: 400 clamp(36px, 4.4vw, 64px) / 1.02 var(--font-display); letter-spacing: -.01em; max-width: 18ch; }
  .lp-h3 { font: 400 24px/1.15 var(--font-display); margin: 18px 0 8px; }
  .lp-lead { font: 400 clamp(18px, 1.5vw, 21px) / 1.5 var(--font-text); max-width: 60ch; margin-top: 20px; }
  .lp-muted { color: var(--ink-muted); }
  .lp-small { font-size: 15px; margin-top: 16px; }
  .lp-head2 { margin-bottom: clamp(36px, 5vw, 64px); }
  section { scroll-margin-top: 84px; }

  /* Buttons */
  .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .lp-actions--center { justify-content: center; }
  .lp-btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: var(--brand-forest); color: #fff !important; text-decoration: none; font: 400 16px/1 var(--font-text); letter-spacing: .06em; border: 1px solid var(--brand-forest); transition: background .25s, transform .25s; }
  .lp-btn:hover { background: #000; transform: translateY(-2px); }
  .lp-btn--ghost { background: transparent; color: var(--ink) !important; border-color: var(--ink); }
  .lp-btn--ghost:hover { background: var(--ink); color: #fff !important; }
  .lp-btn--light { background: var(--cream); color: #151510 !important; border-color: var(--cream); }
  .lp-btn--light:hover { background: #fff; }
  .lp-btn--ghost-light { background: transparent; border-color: var(--cream); }
  .lp-btn--ghost-light:hover { background: var(--cream); color: #151510 !important; }

  /* Reveal */
  .js [data-reveal] { opacity: 0; transform: translateY(26px); filter: blur(10px); transition: opacity .9s ease var(--d, 0ms), transform 1s cubic-bezier(.2,.7,.2,1) var(--d, 0ms), filter .9s ease var(--d, 0ms); }
  .js [data-reveal].in { opacity: 1; transform: none; filter: none; }
  [data-tilt] { transition: transform .5s cubic-bezier(.2,.7,.2,1); transform-style: preserve-3d; will-change: transform; }

  /* Intro */
  .lp-intro { padding: clamp(80px, 10vw, 140px) 0; }
  .lp-intro__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }

  /* Video bands */
  .lp-band { position: relative; height: 78vh; min-height: 420px; overflow: hidden; background: var(--night); }
  .lp-band--short { height: 46vh; min-height: 300px; }
  .lp-band__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lp-band__wash { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; background: linear-gradient(to top, rgba(49,74,52,.65), rgba(49,74,52,.15)); }
  .lp-band__line { max-width: 22ch; text-align: center; color: #fff; font: 400 clamp(30px, 4vw, 58px) / 1.06 var(--font-display); text-shadow: 0 2px 30px rgba(0,0,0,.35); }

  /* Week */
  .lp-week { padding: clamp(80px, 10vw, 140px) 0; background: #f7f4ec; }
  .lp-week__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 36px); }
  .lp-card__media { aspect-ratio: 4 / 5; overflow: hidden; background: #1a2a1e; }
  .lp-card__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-card p { color: var(--ink-muted); }

  /* Is a retreat right for you? (night, like the hero) */
  .lp-who { --mx: 30%; --my: 35%; position: relative; overflow: hidden; padding: clamp(90px, 11vw, 160px) 0; background: var(--night); color: var(--cream); }
  .lp-who__glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(560px circle at var(--mx) var(--my), rgba(120,190,128,.14), transparent 62%), radial-gradient(800px circle at 85% 90%, rgba(49,74,52,.55), transparent 65%), linear-gradient(to bottom, rgba(0,0,0,.35), transparent 30%); }
  .lp-who__flies { position: absolute; inset: 0; pointer-events: none; }
  .lp-who__flies i { position: absolute; left: var(--x); top: var(--y); width: 3px; height: 3px; border-radius: 50%; background: #d6f2d9; box-shadow: 0 0 10px 2px rgba(120,190,128,.65); opacity: 0; animation: lp-fly var(--t) ease-in-out var(--o) infinite; }
  @keyframes lp-fly { 0%, 100% { opacity: 0; transform: translate(0, 0); } 35% { opacity: .9; } 55% { transform: translate(26px, -42px); } 75% { opacity: .4; } }
  .lp-who .lp-wrap { position: relative; }
  .lp-who .lp-label { color: #a8dcae; text-shadow: 0 0 14px rgba(120,190,128,.75), 0 0 2px rgba(168,220,174,.6); }
  .lp-who__title { font-size: clamp(44px, 5vw, 80px); line-height: .98; max-width: none; text-shadow: 0 2px 40px rgba(0,0,0,.45); }
  .lp-who .lp-lead { color: rgba(245,239,226,.82); }
  .lp-who__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .lp-who__photo { margin-top: 36px; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(245,239,226,.08); }
  .lp-who__photo img, .lp-guide__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-who__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .lp-who__list li { display: grid; grid-template-columns: 52px 1fr; gap: 10px; padding: 24px 26px; border: 1px solid rgba(245,239,226,.12); border-radius: 14px; background: radial-gradient(300px circle at var(--x, -300px) var(--y, -300px), rgba(120,190,128,.16), transparent 70%), rgba(255,255,255,.025); }
  .js .lp-anim .lp-who__list li.lp-rise { transition: opacity .9s ease var(--d, 0ms), transform 1s cubic-bezier(.2,.7,.2,1) var(--d, 0ms), filter .9s ease var(--d, 0ms), border-color .3s ease, box-shadow .3s ease; }
  .lp-who__list li:hover { border-color: rgba(120,190,128,.45); box-shadow: 0 0 40px rgba(120,190,128,.08); }
  .lp-who__list .lp-h3 { margin-top: 0; }
  .lp-who__list p { color: rgba(245,239,226,.75); }
  .lp-who__n { font: 400 15px/1.6 var(--font-text); color: #a8dcae; letter-spacing: .1em; text-shadow: 0 0 10px rgba(120,190,128,.55); transition: text-shadow .3s; }
  .lp-who__list li:hover .lp-who__n { text-shadow: 0 0 12px rgba(120,190,128,.9); }

  /* Why */
  .lp-why { padding: clamp(80px, 10vw, 140px) 0; }
  .lp-why__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .lp-stat { border-top: 1px solid var(--ink); padding-top: 24px; }
  .lp-stat__n { font: 400 clamp(48px, 5.6vw, 84px) / 1 var(--font-display); color: var(--brand-forest); }
  .lp-stat__l { font: 500 13px/1.3 var(--font-text); letter-spacing: .2em; text-transform: uppercase; margin: 12px 0 10px; }

  /* Finca rail */
  .lp-finca { padding: clamp(80px, 10vw, 140px) 0; background: #0b130f; color: #fff; overflow: hidden; }
  .lp-finca .lp-label { color: var(--brand-ochre); }
  .lp-finca .lp-lead { color: rgba(255,255,255,.85); }
  .lp-finca__duo { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 22px; margin-top: 40px; }
  .lp-duo__media { aspect-ratio: 4 / 5; overflow: hidden; background: #1a2a1e; }
  .lp-duo__media:first-child { aspect-ratio: auto; }
  .lp-duo__media video { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Days */
  .lp-days { padding: clamp(80px, 10vw, 140px) 0; background: #f7f4ec; }

  /* Guides */
  .lp-guides { padding: clamp(80px, 10vw, 140px) 0; }
  .lp-guides__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 64px); }
  .lp-guide__photo { aspect-ratio: 4 / 3; overflow: hidden; }
  .lp-guide p { color: var(--ink-muted); max-width: 54ch; }

  /* Dates */
  .lp-dates { padding: clamp(80px, 10vw, 140px) 0; background: var(--brand-forest); color: #fff; }
  .lp-dates .lp-label { color: var(--brand-ochre); }
  .lp-dates .lp-muted { color: rgba(255,255,255,.75); }
  .lp-dates .lp-btn { background: var(--brand-ochre); color: #000 !important; border-color: var(--brand-ochre); }
  .lp-dates .lp-btn--ghost { background: transparent; color: #fff !important; border-color: #fff; }

  /* Reviews */

  /* Social */
  .lp-social { padding: 0 0 clamp(80px, 10vw, 130px); }

  /* FAQ */
  .lp-faq { padding: clamp(80px, 10vw, 130px) 0; background: #f7f4ec; }
  .lp-faq__item { border-top: 1px solid var(--hairline); padding: 22px 0; }
  .lp-faq__item:last-child { border-bottom: 1px solid var(--hairline); }
  .lp-faq__item summary { cursor: pointer; font: 400 22px/1.25 var(--font-display); list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .lp-faq__item summary::after { content: '+'; font-family: var(--font-text); transition: transform .3s; }
  .lp-faq__item[open] summary::after { transform: rotate(45deg); }
  .lp-faq__item p { margin-top: 14px; color: var(--ink-muted); max-width: 62ch; }

  /* Final */
  .lp-final { position: relative; min-height: 80vh; display: grid; place-items: center; color: #fff; text-align: center; overflow: hidden; background: var(--night); }
  .lp-final__scene { position: absolute; inset: 0; }
  .lp-final__scene::after { content: ''; position: absolute; inset: 0; background: rgba(5,10,8,.55); }
  .lp-final__inner { position: relative; z-index: 1; padding: 100px 20px; }
  .lp-final__title { font: 400 clamp(48px, 7vw, 112px) / .95 var(--font-display); }
  .lp-final .lp-lead { margin: 24px auto 0; color: rgba(255,255,255,.9); }

  /* Footer */
  .lp-foot { background: #050a08; color: rgba(245,239,226,.7); font-size: 14px; }
  .lp-foot__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 28px; padding-bottom: 28px; }
  .lp-foot a { color: inherit; }
  .lp-linkbtn { background: none; border: 0; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; padding: 0; }

  /* Sticky call button */
  .lp-sticky { position: fixed; right: 20px; bottom: 20px; z-index: 50; display: inline-flex; align-items: center; min-height: 50px; padding: 0 24px; background: var(--brand-ochre); color: #000 !important; text-decoration: none; letter-spacing: .06em; box-shadow: 0 10px 30px rgba(0,0,0,.25); transform: translateY(120px); transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .lp-sticky.on { transform: none; }
  body.banner-open .lp-sticky { display: none; }

  a:focus-visible, button:focus-visible, summary:focus-visible, .lp-rail:focus-visible { outline: 2px solid var(--brand-slate); outline-offset: 3px; }


  /* Week cards: number badge, photos fill the frame */
  .lp-card__media { position: relative; }
  .lp-card__media img, .lp-card__media picture { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-card__n { position: absolute; left: 16px; top: 14px; font: 400 15px/1 var(--font-display); color: #fff; letter-spacing: .08em; text-shadow: 0 1px 10px rgba(0,0,0,.6); }
  .lp-card--hero { grid-column: span 2; }
  .lp-card--hero .lp-card__media { aspect-ratio: 16 / 9.6; }
  .lp-week__grid { grid-template-columns: repeat(3, 1fr); }

  /* Spaces: bento grid with captions over the photos */
  .lp-spaces { list-style: none; padding: 0; margin: 10px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(200px, 19vw, 290px); grid-auto-flow: dense; gap: 14px; }
  .lp-space { position: relative; overflow: hidden; border-radius: 6px; background: #1a2a1e; outline: none; }
  .lp-space--big { grid-column: span 2; grid-row: span 2; }
  .lp-space--tall { grid-row: span 2; }
  .lp-space picture, .lp-space img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .lp-space::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(3,12,9,.92) 0%, rgba(3,12,9,.35) 45%, transparent 70%); transition: background .5s; }
  .lp-space__cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 18px 20px; }
  .lp-space__tag { font: 500 11px/1 var(--font-text); letter-spacing: .2em; text-transform: uppercase; color: var(--brand-ochre); }
  .lp-space__name { font: 400 clamp(22px, 2vw, 30px)/1.05 var(--font-display); margin: 8px 0 0; color: #fff; }
  .lp-space--big .lp-space__name { font-size: clamp(30px, 3.2vw, 48px); }
  .lp-space__text { margin: 8px 0 0; font-size: 15px; line-height: 1.45; color: rgba(255,255,255,.85); max-height: 0; opacity: 0; overflow: hidden; transition: max-height .5s, opacity .5s; }
  .lp-space--big .lp-space__text { max-height: 6em; opacity: 1; }
  .lp-space:hover img, .lp-space:focus-visible img { transform: scale(1.06); }
  .lp-space:hover .lp-space__text, .lp-space:focus-visible .lp-space__text { max-height: 6em; opacity: 1; }
  .lp-space:hover::after { background: linear-gradient(to top, rgba(3,12,9,.95) 0%, rgba(3,12,9,.5) 60%, rgba(3,12,9,.1)); }
  .lp-finca__duo { margin-top: 14px; }

  /* Day by day: tabs + photo panel */
  .lp-days__tabs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 6px; margin-bottom: 28px; }
  .lp-days__tabs::-webkit-scrollbar { display: none; }
  .lp-days__tabs button { flex: 1 0 auto; min-width: 128px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 16px 18px; border: 1px solid var(--hairline); border-radius: 6px; background: #fff; cursor: pointer; text-align: left; color: var(--ink); transition: background .3s, color .3s, border-color .3s; }
  .lp-days__tabs button span { font: 500 11px/1 var(--font-text); letter-spacing: .2em; text-transform: uppercase; color: var(--brand-slate); }
  .lp-days__tabs button strong { font: 400 18px/1.1 var(--font-display); }
  .lp-days__tabs button:hover { border-color: var(--brand-forest); }
  .lp-days__tabs button[aria-selected=true] { background: var(--brand-forest); border-color: var(--brand-forest); color: #fff; }
  .lp-days__tabs button[aria-selected=true] span { color: var(--brand-ochre); }
  .lp-day { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: stretch; }
  .lp-day--in .lp-day__photo, .lp-day--in .lp-day__body { animation: lp-dayin .7s cubic-bezier(.2,.7,.2,1) both; }
  .lp-day--in .lp-day__body { animation-delay: .08s; }
  @keyframes lp-dayin { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .lp-day__photo { position: relative; min-height: 420px; border-radius: 6px; overflow: hidden; }
  .lp-day__photo picture, .lp-day__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lp-day__big { position: absolute; right: 18px; bottom: -0.12em; font: 400 clamp(140px, 16vw, 240px)/1 var(--font-display); color: rgba(255,255,255,.88); text-shadow: 0 8px 40px rgba(0,0,0,.35); }
  .lp-day__title { font: 400 clamp(32px, 3.4vw, 52px)/1 var(--font-display); margin: 10px 0 24px; }
  .lp-day__list { list-style: none; padding: 0; margin: 0; }
  .lp-day__list li { display: grid; grid-template-columns: 92px 1fr; gap: 16px; padding: 13px 0; border-top: 1px solid var(--hairline); font-size: 17px; }
  .lp-day__list li:last-child { border-bottom: 1px solid var(--hairline); }
  .lp-day__list time { font: 500 13px/1.6 var(--font-text); letter-spacing: .06em; color: var(--brand-terracotta); white-space: nowrap; }

  /* Prices: room cards */
  .lp-dates .lp-lead { color: rgba(255,255,255,.85); }
  .lp-rooms { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .lp-room { display: flex; flex-direction: column; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); border-radius: 8px; overflow: hidden; transition: transform .4s, background .4s; }
  .lp-room:hover { transform: translateY(-6px); background: rgba(255,255,255,.1); }
  .lp-room--pick { border-color: var(--brand-ochre); box-shadow: 0 0 0 1px var(--brand-ochre); }
  .lp-room__photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .lp-room__photo picture, .lp-room__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-room__tag { position: absolute; top: 12px; left: 12px; padding: 7px 12px; border-radius: 99px; background: var(--brand-ochre); color: #000; font: 500 11px/1 var(--font-text); letter-spacing: .14em; text-transform: uppercase; }
  .lp-room__body { display: flex; flex-direction: column; flex: 1; padding: 22px 22px 24px; }
  .lp-room__name { font: 400 24px/1.1 var(--font-display); margin: 0; }
  .lp-room__who { margin: 6px 0 0; font-size: 14px; letter-spacing: .04em; color: rgba(255,255,255,.65); }
  .lp-room__price { margin: 18px 0 0; }
  .lp-room__price strong { font: 400 46px/1 var(--font-display); color: #fff; }
  .lp-room__price span { font-size: 14px; letter-spacing: .12em; color: var(--brand-ochre); }
  .lp-room__text { margin: 14px 0 20px; font-size: 15px; line-height: 1.5; color: rgba(255,255,255,.78); flex: 1; }
  .lp-room__cta { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--brand-ochre) !important; text-decoration: none; }
  .lp-room__cta:hover { text-decoration: underline; }
  .lp-included { margin-top: 36px; padding: 28px 30px; border-radius: 8px; background: rgba(0,0,0,.18); }
  .lp-included ul { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-included li { padding: 8px 14px; border-radius: 99px; border: 1px solid rgba(255,255,255,.3); font-size: 14px; }
  .lp-included li::before { content: '✓ '; color: var(--brand-ochre); }
  .lp-dates__head { margin-top: clamp(64px, 8vw, 110px); }
  .lp-cal { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .lp-cal li { display: flex; }
  .lp-cal a { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 22px 22px 20px; border-radius: 8px; background: #f5efe2; color: #151510 !important; text-decoration: none; transition: transform .35s, background .35s; }
  .lp-cal a:hover { transform: translateY(-5px); background: var(--brand-ochre); }
  .lp-cal__mon { font: 500 12px/1 var(--font-text); letter-spacing: .22em; text-transform: uppercase; color: var(--brand-terracotta); }
  .lp-cal a:hover .lp-cal__mon { color: #151510; }
  .lp-cal__range { font: 400 36px/1.05 var(--font-display); }
  .lp-cal__meta { font-size: 14px; color: rgba(21,21,16,.65); }
  .lp-cal__go { margin-top: 8px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }

  /* Reviews over the dinner video */
  .lp-reviews { position: relative; color: #fff; background: var(--night); overflow: hidden; }
  .lp-reviews__bg { position: absolute; inset: 0; }
  .lp-reviews__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(4,12,9,.92) 0%, rgba(4,12,9,.7) 50%, rgba(4,12,9,.55)); }
  .lp-reviews__inner { position: relative; z-index: 1; display: grid; grid-template-columns: 0.8fr 1.6fr; gap: clamp(32px, 5vw, 80px); align-items: center; padding-top: clamp(80px, 10vw, 140px); padding-bottom: clamp(80px, 10vw, 140px); }
  .lp-reviews .lp-label { color: var(--brand-ochre); }
  .lp-reviews__big { font: 400 clamp(110px, 13vw, 190px)/.9 var(--font-display); margin: 10px 0 0; }
  .lp-reviews__stars { color: var(--brand-ochre); font-size: 26px; letter-spacing: .14em; margin: 8px 0 4px; }
  .lp-reviews__src { list-style: none; padding: 0; margin: 22px 0 0; }
  .lp-reviews__src li { padding: 10px 0; border-top: 1px solid rgba(255,255,255,.2); font-size: 15px; }
  .lp-reviews__src strong { font: 400 20px/1 var(--font-display); margin-right: 8px; }
  .lp-reviews__note { color: rgba(255,255,255,.6); }
  .lp-quotes { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 18px; }
  .lp-quotes li { position: relative; break-inside: avoid; margin-bottom: 18px; padding: 30px 28px 24px; border-radius: 8px; background: rgba(245,239,226,.1); border: 1px solid rgba(245,239,226,.18); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .lp-quotes li:nth-child(3n+1) { background: rgba(245,239,226,.94); color: #151510; }
  .lp-quotes__mark { position: absolute; top: 6px; right: 18px; font: 400 80px/1 var(--font-display); color: var(--brand-ochre); opacity: .8; }
  .lp-quotes blockquote { font: 400 23px/1.3 var(--font-display); margin: 0 0 16px; }
  .lp-quotes__who { font-size: 14px; letter-spacing: .04em; opacity: .9; margin: 0; }

  /* Social: pills + photo/video mosaic */
  .lp-social { padding: clamp(80px, 10vw, 130px) 0; }
  .lp-social__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; flex-wrap: wrap; margin-bottom: 32px; }
  .lp-social__pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .lp-social__pills a { display: inline-flex; gap: 8px; align-items: baseline; padding: 12px 18px; border-radius: 99px; border: 1px solid var(--ink); text-decoration: none; font-size: 15px; transition: background .3s, color .3s; }
  .lp-social__pills a span { color: var(--ink-muted); }
  .lp-social__pills a:hover { background: var(--brand-forest); color: #fff; border-color: var(--brand-forest); }
  .lp-social__pills a:hover span { color: rgba(255,255,255,.8); }
  .lp-mosaic { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(150px, 15vw, 230px); gap: 10px; text-decoration: none; }
  .lp-mosaic__tile { position: relative; overflow: hidden; border-radius: 6px; background: #1a2a1e; }
  .lp-mosaic__tile--0 { grid-column: span 2; grid-row: span 2; }
  .lp-mosaic__tile--3 { grid-row: span 2; }
  .lp-mosaic__tile video, .lp-mosaic__tile picture, .lp-mosaic__tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1s; }
  .lp-mosaic:hover .lp-mosaic__tile img, .lp-mosaic:hover .lp-mosaic__tile video { transform: scale(1.04); }
  .lp-mosaic__badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 22px 30px; border-radius: 10px; background: rgba(245,239,226,.95); color: #151510; box-shadow: 0 20px 50px rgba(0,0,0,.3); text-align: center; }
  .lp-mosaic__badge strong { font: 400 26px/1 var(--font-display); }
  .lp-mosaic__badge span { font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--brand-terracotta); }

  /* FAQ with a photo */
  .lp-faq__grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .lp-faq__side { position: sticky; top: 40px; }
  .lp-faq__photo { margin-top: 28px; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; }
  .lp-faq__photo picture, .lp-faq__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 1100px) {
    .lp-rooms { grid-template-columns: repeat(2, 1fr); }
    .lp-cal { grid-template-columns: repeat(2, 1fr); }
    .lp-spaces { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) {
    .lp-week__grid { grid-template-columns: 1fr; }
    .lp-card--hero { grid-column: auto; }
    .lp-card__media, .lp-card--hero .lp-card__media { aspect-ratio: 16 / 11; }
    .lp-spaces { grid-template-columns: 1fr 1fr; grid-auto-rows: 210px; gap: 10px; }
    .lp-space--big { grid-column: 1 / -1; grid-row: span 2; }
    .lp-space__name { font-size: 20px; }
    .lp-space__cap { padding: 12px 14px; }
    .lp-day { grid-template-columns: 1fr; }
    .lp-day__photo { min-height: 260px; }
    .lp-day__list li { grid-template-columns: 78px 1fr; font-size: 16px; }
    .lp-days__tabs button { min-width: 112px; }
    .lp-rooms { grid-template-columns: 1fr; }
    .lp-room__photo { aspect-ratio: 16 / 9; }
    .lp-cal { grid-template-columns: 1fr 1fr; }
    .lp-cal__range { font-size: 28px; }
    .lp-reviews__inner { grid-template-columns: 1fr; }
    .lp-quotes { columns: 1; }
    .lp-mosaic { grid-template-columns: 1fr 1fr; grid-auto-rows: 140px; }
    .lp-mosaic__tile--3 { grid-row: auto; }
    .lp-mosaic__tile:nth-child(n+7) { display: none; }
    .lp-faq__grid { grid-template-columns: 1fr; }
    .lp-faq__side { position: static; }
    .lp-faq__photo { aspect-ratio: 16 / 10; }
  }

  @media (max-width: 700px) {
    .lp-why__grid { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 820px) {
    .lp { --u: 1px; }
    .lp-head { padding: 16px 18px; }
    .lp-head.solid .lp-head__logo img { width: 84px; min-width: 84px; }
    .lp-who__list li { padding: 20px 18px; grid-template-columns: 40px 1fr; }
    .lp-head__nav a:not(.lp-pill) { display: none; }
    .lp-pill { height: 40px; padding: 0 16px; font-size: 12px; }
    .lp-eyebrow { font-size: 11px; }
    .lp-hero__title { font-size: clamp(56px, 16vw, 92px); }
    .lp-hero__cap { font-size: 16px; }
    .lp-corner { left: 20px; right: 20px; bottom: 28px; justify-content: center; font-size: 11px; }
    .lp-intro__grid, .lp-who__grid, .lp-guides__grid, .lp-dates__grid, .lp-faq__grid { grid-template-columns: 1fr; }
    .lp-week__grid { grid-template-columns: 1fr; }
    .lp-finca__duo { grid-template-columns: 1fr 1fr; }
    .lp-duo__media:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
    .lp-sticky { left: 16px; right: 16px; bottom: 16px; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js [data-reveal] { opacity: 1; transform: none; transition: none; }
    .lp-loader span { animation: none; }
    .js .lp-anim .lp-rise, .js .lp-anim .lp-w > span { opacity: 1; transform: none; filter: none; transition: none; }
    .lp-who__flies { display: none; }
  }
  /* ===== One look for the whole page: the Finca night palette ===== */
  .lp { --deep: rgba(11,19,15,.82); --deep2: rgba(8,16,12,.88); --surface: var(--deep); --ink: #fff; --ink-muted: rgba(245,239,226,.72); --label-ink: var(--brand-ochre); --hairline: rgba(245,239,226,.16); --accent-text: var(--brand-ochre); --focus-ring: var(--cream); color: #fff; background: var(--night); }
  .lp-who { background: linear-gradient(to bottom, rgba(5,10,8,.35), rgba(5,10,8,.7) 40%, var(--deep)); }
  .lp-intro, .lp-why, .lp-days, .lp-dates { background: var(--deep); color: #fff; }
  .lp-week, .lp-finca, .lp-guides, .lp-social, .lp-faq { background: var(--deep2); color: #fff; }
  .lp-who .lp-label { color: var(--brand-ochre); text-shadow: none; }
  .lp-lead { color: rgba(245,239,226,.85); }
  .lp-btn { background: var(--brand-ochre); color: #000 !important; border-color: var(--brand-ochre); }
  .lp-btn:hover { background: #fff; border-color: #fff; }
  .lp-btn--ghost, .lp-dates .lp-btn--ghost { background: transparent; color: var(--cream) !important; border-color: rgba(245,239,226,.6); }
  .lp-btn--ghost:hover, .lp-dates .lp-btn--ghost:hover { background: var(--cream); color: #000 !important; border-color: var(--cream); }
  .lp-btn--ghost-light { background: transparent; color: var(--cream) !important; border-color: rgba(245,239,226,.6); }
  .lp-btn--ghost-light:hover { background: var(--cream); color: #000 !important; border-color: var(--cream); }
  .lp-band__wash { background: linear-gradient(to top, rgba(5,10,8,.8), rgba(5,10,8,.2)); }
  .lp-stat { border-top-color: var(--hairline); }
  .lp-stat__n { color: #fff; }
  .lp-days__tabs button { background: rgba(255,255,255,.04); color: #fff; }
  .lp-days__tabs button span { color: var(--brand-ochre); }
  .lp-days__tabs button:hover { border-color: var(--brand-ochre); }
  .lp-days__tabs button[aria-selected=true] { background: var(--brand-ochre); border-color: var(--brand-ochre); color: #000; }
  .lp-days__tabs button[aria-selected=true] span { color: rgba(0,0,0,.7); }
  .lp-day__list time { color: var(--brand-ochre); }
  .lp-cal a { background: rgba(255,255,255,.05); border: 1px solid var(--hairline); color: #fff !important; }
  .lp-cal a:hover { background: var(--brand-ochre); border-color: var(--brand-ochre); color: #000 !important; }
  .lp-cal__mon { color: var(--brand-ochre); }
  .lp-cal__meta { color: var(--ink-muted); }
  .lp-cal a:hover .lp-cal__meta { color: rgba(0,0,0,.7); }
  .lp-quotes li:nth-child(3n+1) { background: rgba(245,239,226,.1); color: inherit; }
  .lp-social__pills a { border-color: var(--hairline); }
  .lp-social__pills a:hover { background: var(--brand-ochre); border-color: var(--brand-ochre); color: #000; }
  .lp-social__pills a:hover span { color: rgba(0,0,0,.7); }
  .lp-mosaic__badge { background: rgba(5,10,8,.82); color: var(--cream); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--hairline); }
  .lp-mosaic__badge span { color: var(--brand-ochre); }
  .lp-faq__item summary::after { color: var(--brand-ochre); }

  /* Blog */
  .lp-blog { padding: clamp(80px, 10vw, 140px) 0; background: var(--deep); color: #fff; }
  .lp-blog__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(36px, 5vw, 56px); }
  .lp-blog__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .lp-post { display: flex; flex-direction: column; text-decoration: none; padding: 14px 14px 22px; border: 1px solid var(--hairline); border-radius: 10px; background: rgba(255,255,255,.035); transition: border-color .3s, background .3s; }
  .lp-post:hover { border-color: var(--brand-ochre); background: rgba(255,255,255,.06); }
  .lp-post__photo { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 6px; background: #1a2a1e; }
  .lp-post__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .lp-post:hover .lp-post__photo img { transform: scale(1.05); }
  .lp-post__date { margin: 18px 8px 0; font: 500 12px/1 var(--font-text); letter-spacing: .2em; text-transform: uppercase; color: var(--brand-ochre); }
  .lp-post .lp-h3 { margin: 12px 8px 8px; }
  .lp-post__text { margin: 0 8px; font-size: 15px; line-height: 1.5; color: var(--ink-muted); flex: 1; }
  .lp-post__more { margin: 18px 8px 0; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--brand-ochre); }
  @media (max-width: 820px) { .lp-blog__grid { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) {
    .js [data-reveal] { filter: none; }
  }
</style>
</body>
