---
// Landing page for paid ads (Google Search). It describes the week, the place,
// the people and the dates without naming any substance, and has no site menu,
// so it never links to the medicine pages. Hidden from search (noindex).
import '../styles/tokens.css';
import '../styles/global.css';
import calSans from '../assets/fonts/CalSans-Regular.woff2?url';
import tenorSans from '../assets/fonts/TenorSans-Regular.woff2?url';
import lockup from '../assets/brand/lockup-white.png';
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Photo from '../components/Photo.astro';
import CookieBanner from '../components/CookieBanner.astro';
import site from '../data/site.json';
import rooms from '../data/rooms.json';
import retreats from '../data/retreats.json';
import { href, whatsappUrl } from '../lib/url';
import { getCollection } from 'astro:content';

const title = 'A 7-Day Retreat in the Highlands of Jalisco, Mexico | MexiSol World';
const description = 'Seven days on a ranch an hour from Guadalajara: evening ceremonies with live music, temazcal, fire circle, horses and every meal. Up to 15 guests, from $1,850 USD all-inclusive.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const v = Date.now().toString(36);
const call = site.booking.url;
const from = Math.min(...rooms.rooms.map((r) => r.priceUsd));
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const today = new Date().toISOString().slice(0, 10);

// Blog: the newest English articles whose title names no substance or medicine
const offTopic = /ayahuasca|psilocybin|mushroom|psychedelic|macrodos|microdos|satori|ssri|medication|kambo|bufo|dmt/i;
const posts = (await getCollection('blog', (p) => p.id.startsWith('en/') && !p.data.draft && p.data.date <= new Date() && !offTopic.test(p.data.title)))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3)
  .map((p) => ({ slug: p.id.replace(/^en\//, ''), ...p.data }));
const guideOf: Record<string, string> = { ayahuasca: 'Humberto', psilocybin: 'Krista' };
const dates = retreats.finca
  .filter((r) => guideOf[r.medicine] && r.start > today)
  .slice(0, 8)
  .map((r) => {
    const s = new Date(`${r.start}T12:00:00`);
    const e = new Date(`${r.end}T12:00:00`);
    const month = s.toLocaleString('en-US', { month: 'short' });
    const endMonth = e.toLocaleString('en-US', { month: 'short' });
    return {
      id: r.id,
      guide: guideOf[r.medicine],
      when: month === endMonth ? `${month} ${s.getDate()} to ${e.getDate()}` : `${month} ${s.getDate()} to ${endMonth} ${e.getDate()}`,
      mon: s.toLocaleString('en-US', { month: 'long' }),
      range: month === endMonth ? `${s.getDate()}–${e.getDate()}` : `${s.getDate()} ${month} – ${e.getDate()} ${endMonth}`,
      year: s.getFullYear(),
    };
  });

// The ten things every week holds. Each card is a video loop or a photo.
const week = [
  { video: 'osho-hut', n: '3', title: 'Three ceremonies', text: 'Three ceremonies in the Osho Hut, a round temple of stone and palm, held by your guide with live music from start to finish.' },
  { photo: 'finca-ceremonia-circulo', title: 'Integration sessions', text: 'Group circles after every ceremony and one-on-one time with an integration coach, so what you lived turns into what you keep.' },
  { photo: 'finca-kambo-ceremonia', title: 'Kambo', text: 'A traditional Amazonian cleansing ceremony, held in the morning by our facilitators. We explain it in detail on your call.' },
  { photo: 'finca-grupo-yoga-oraculo', title: 'Yoga', text: 'Yoga flow between the onyx pillars of the Oracle, in the soft light of the morning.' },
  { photo: 'finca-ceremonia-cacao', title: 'Cacao ceremony', text: 'Warm ceremonial cacao, songs and intentions in the Osho Hut on the last afternoon.' },
  { video: 'fire-circle', title: 'Fire circle', text: 'A night around the fire to say what the week has opened, and to let some of it go.' },
  { photo: 'finca-esp-temazcal-3', title: 'Temazcal', text: 'The traditional sweat lodge: heat, steam, herbs and songs, then cold water under the open sky.' },
  { photo: 'finca-cocina-comida', title: 'Every meal, on the retreat diet', text: 'Cooked here from whole ingredients, many from the Gaia greenhouse. Mostly plant-based, with no alcohol, refined sugar or processed food. Vegan and gluten-free covered.' },
  { video: 'wolf', title: 'Meet the wolves', text: 'Two rescued wolf brothers live on the land. Meet them with their keeper, calmly and with respect.' },
  { video: 'riders-agave', title: 'Horses and free time', text: 'Ride through the agave with the Finca’s nine horses, or take the afternoon: pool, jacuzzi, gym, massages, the lake.' },
];

// Spaces of the Finca (photos and names from fincaelpendulo.com.mx/espacios)
const spaces = [
  { photo: 'finca-esp-osho-hut-3', name: 'Osho Hut', tag: 'Ceremonial temple', text: 'The heart of the Finca: a round stone temple with a palm roof and a marble floor. Every ceremony happens here.', big: true },
  { photo: 'finca-esp-oraculo-2', name: 'The Oracle', tag: 'Open-air circle', text: 'Sixteen onyx pillars from Jalisco, each carved with a rune. Morning yoga and the fire circle.' },
  { photo: 'finca-esp-temazcal-3', name: 'Temazcal', tag: 'Sweat lodge', text: 'A traditional dome of heat and steam, with cold-water tubs outside.' },
  { photo: 'finca-esp-lago-1', name: 'Lake Avalon', tag: 'Nature', text: 'Koi, turtles, loungers in the sun and paths for evening walks.', tall: true },
  { photo: 'finca-card-sammasati', name: 'Sammasati', tag: 'Common area', text: 'A long wooden table for 25, an eight-person jacuzzi and a fire pit.' },
  { photo: 'finca-invernadero-mesa', name: 'El 27', tag: 'Greenhouse dining room', text: 'A long table among hanging plants, lit by clay lamps at night.' },
  { photo: 'finca-esp-terraza-ambu-1', name: 'Terraza Ambú', tag: 'Terrace', text: 'Views over the agave fields. The celebration dinner on the last night.', big: true },
  { photo: 'finca-esp-caballerizas-1', name: 'The stables', tag: 'Nine horses', text: 'Five of the horses were born here. Ride, groom, or simply be with them.' },
  { photo: 'finca-esp-lobos-1', name: 'The wolves', tag: 'Two rescued brothers', text: 'Met in a guided, respectful visit.' },
  { photo: 'finca-alberca-01', name: 'Pool', tag: 'Heated all year', text: 'Surrounded by gardens, for slow afternoons.' },
  { photo: 'finca-card-gaia', name: 'Gaia greenhouse', tag: 'Garden', text: 'Herbs, vegetables, fruit and medicinal plants that end up on your plate.' },
  { photo: 'finca-taller-ceramica', name: 'Art studio', tag: 'Pottery and painting', text: 'Five pottery wheels. The opening journey starts here.' },
  { photo: 'finca-card-spa', name: 'Spa', tag: 'Massage', text: 'Massages and treatments by appointment.' },
  { photo: 'finca-card-gimnasio', name: 'Gym', tag: 'Movement', text: 'Weights, a Pilates reformer, treadmills, ping pong and billiards.' },
  { photo: 'finca-jardin-rosas', name: 'Rose garden', tag: 'Quiet corner', text: 'Just behind the Osho Hut, for quiet time after ceremony.' },
];

const forWho = [
  { title: 'At a crossroads', text: 'A job, a relationship, a city, a decade. Some decisions need more than a long weekend.' },
  { title: 'Ready to break a pattern', text: 'Same year, same loops. A week to look at them from the outside, with people who get it.' },
  { title: 'Caring for everyone else', text: 'Nurses, parents, founders, carers. A week where someone else holds the space for you.' },
  { title: 'Coming back to the work', text: 'You have sat in ceremony before and know it is time to return, somewhere small and personal.' },
  { title: 'Curious, and careful', text: 'You have read and listened for years. You want to do this once, properly, with a team you trust.' },
];

const why = [
  { n: '15', label: 'guests at most', text: 'A small group, so every person is seen.' },
  { n: '4.9', label: 'from 236 reviews', text: '5.0 on BookRetreats and 4.92 on Retreat Guru.' },
  { n: '1 h', label: 'from Guadalajara airport', text: 'Direct flights from most US hubs. Pickup available.' },
];

// Day by day, from the guest brochure
const days = [
  { d: 'Day 1', t: 'Arrival', photo: 'finca-esp-caballerizas-1', items: [['12:00 pm', 'Check in'], ['2:00 pm', 'Lunch'], ['4:00 pm', 'Welcome tour of the Finca and the stables'], ['8:00 pm', 'Dinner']] },
  { d: 'Day 2', t: 'First ceremony', photo: 'finca-taller-ceramica', items: [['8:00 am', 'Light breakfast'], ['9:00 am', 'Orientation and meeting the team'], ['10:00 am', 'Opening journey in the pottery studio'], ['11:00 am', 'Kambo ceremony'], ['1:00 pm', 'Light lunch'], ['2:00 pm', 'Free time'], ['4:15 pm', 'Integration session'], ['7:00 pm', 'Meditation'], ['7:30 pm', 'First ceremony in the Osho Hut']] },
  { d: 'Day 3', t: 'Second ceremony', photo: 'finca-cabalgata', items: [['9:00 am', 'Breakfast buffet'], ['10:30 am', 'Horse riding or free time'], ['11:00 am', 'Yoga flow'], ['1:00 pm', 'Second ceremony in the Osho Hut'], ['9:00 pm', 'Dinner at Sammasati']] },
  { d: 'Day 4', t: 'Third ceremony', photo: 'finca-esp-lobos-1', items: [['9:00 am', 'Kambo ceremony'], ['9:30 am', 'Light snacks'], ['12:00 pm', 'Yoga flow, horse riding, free time'], ['1:00 pm', 'Light lunch'], ['3:00 pm', 'Group integration'], ['5:00 pm', 'Free time, meet the wolves'], ['7:00 pm', 'Third ceremony in the Osho Hut']] },
  { d: 'Day 5', t: 'Fire', photo: 'finca-vat-meditacion-fogata', items: [['9:00 am', 'Light breakfast'], ['10:30 am', 'Morning in the Osho Hut'], ['1:30 pm', 'Circle of Words'], ['4:30 pm', 'Lunch buffet'], ['5:30 pm', 'Free time'], ['6:30 pm', 'Fire circle ceremony at the Oracle'], ['9:00 pm', 'Dinner']] },
  { d: 'Day 6', t: 'Closing', photo: 'finca-esp-terraza-ambu-1', items: [['7:00 am', 'Sunrise hike to Cerro de la Campana'], ['9:00 am', 'Breakfast buffet'], ['10:30 am', 'Temazcal'], ['2:00 pm', 'Lunch'], ['3:30 pm', 'Cacao ceremony'], ['6:00 pm', 'Free time'], ['8:00 pm', 'Celebration dinner at Terraza Ambú']] },
  { d: 'Day 7', t: 'Departure', photo: 'finca-aerea-laguna-palapa', items: [['Morning', 'Breakfast and goodbyes'], ['', 'Ride to Guadalajara airport']] },
];

// Rooms: cover photo from src/assets/rooms/<folder>/01-*.jpg
const roomPhotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/rooms/*/01-*.jpg', { eager: true });
const roomCover = (folder: string) => Object.entries(roomPhotos).find(([p]) => p.includes(`/rooms/${folder}/`))![1].default;
const roomInfo: Record<string, { folder: string; who: string; text: string; tag?: string }> = {
  dorm: { folder: 'dorm', who: 'Shared with up to 3 guests', text: 'In the Hormiguero, the house volunteers built among the banana trees. Good if you are coming on your own and want company.' },
  'semi-private': { folder: 'villa', who: '1 or 2 guests', text: 'Shared bathroom and privacy curtains, east-facing for sunrise and the horses.' },
  private: { folder: 'private', who: '1 or 2 guests', text: 'Your own room with a private bathroom.' },
  deluxe: { folder: 'deluxe', who: 'Up to 3 guests', text: 'Queen bed, sofa bed, private bathroom and its own jacuzzi. Only two of them.' },
};
const roomCards = rooms.rooms.map((r) => ({ ...r, ...roomInfo[r.id], cover: roomCover(roomInfo[r.id].folder) }));
const included = ['6 nights', 'All meals', '3 ceremonies', 'Kambo', 'Integration', 'Temazcal', 'Cacao', 'Fire circle', 'Yoga', 'Horses', 'Sunrise hike'];

const reviews = [
  { q: 'From the first day, I felt cared for and safe.', n: 'Jay', s: 'BookRetreats' },
  { q: "One of the best things I've ever done in my life.", n: 'Thibault', s: 'BookRetreats' },
  { q: 'The location itself is a little magical, with nature, animals, and sacred spaces.', n: 'Jannie', s: 'BookRetreats' },
  { q: 'A little piece of heaven in Mexico', n: 'Joanne', s: 'Retreat Guru' },
  { q: 'Had a great experience and felt incredible and cared for throughout the journey.', n: 'Sanjay', s: 'BookRetreats' },
];

const social = [
  { name: 'Instagram', handle: '@mexisol.world', url: site.instagram },
  { name: 'TikTok', handle: '@mexisolworld', url: 'https://www.tiktok.com/@mexisolworld' },
  { name: 'Facebook', handle: 'MexiSol World', url: 'https://www.facebook.com/profile.php?id=61595985106785' },
  { name: 'YouTube', handle: 'Finca El Péndulo', url: site.youtube.channel },
];

const social_tiles = [
  { video: 'aerial-finca' },
  { photo: 'finca-ceremonia-cacao' },
  { photo: 'finca-palapa-sobre-laguna' },
  { video: 'horse-close' },
  { photo: 'finca-el-27-noche' },
  { photo: 'finca-yoga-palapa' },
  { video: 'flower-mandala' },
  { photo: 'finca-cena-candiles' },
];

const faq = [
  { q: "What's included?", a: `Six nights, all meals, three ceremonies with live music, Kambo, cacao ceremony, temazcal, fire circle, yoga, group and one-on-one integration, the sunrise hike, horses, the wolves, pool and lake. From ${usd(from)} USD per person. Airport pickup is ${usd(rooms.airportPickup.roundTripUsd)} round trip.` },
  { q: 'Is this right for me?', a: 'Every guest has a free call with our team and fills in a health questionnaire before booking. On that call we explain each ceremony in detail and answer every question, so you decide with all the information.' },
  { q: 'Can I come on my own?', a: 'Most guests do. The group is small, and by the first dinner nobody feels like a stranger.' },
  { q: 'How do I get there?', a: 'Fly into Guadalajara (GDL). The Finca is in Tepatitlán, about an hour away. We can pick you up at the airport.' },
  { q: 'What language is the retreat in?', a: 'English, with a bilingual team. Spanish speakers are welcome too.' },
  { q: 'How do I book?', a: `Book a free call, then reserve your room with a ${rooms.booking.depositPercent}% deposit. The balance is due ${rooms.booking.balanceDaysBefore} days before arrival.` },
];

const csp = [
  "default-src 'self'",
  "script-src 'self' https://www.googletagmanager.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com",
  "font-src 'self'",
  "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com",
  "media-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  'upgrade-insecure-requests',
].join('; ');
const vid = (n: string) => `${base}/video/lp/${n}`;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" />
  <script is:inline src={`${base}/js/boot.js?v=${v}`} data-ga={site.ga4Id || undefined}></script>
  {site.ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={`${site.url}/jalisco-retreat`} />
  <link rel="preload" href={tenorSans} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={calSans} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${site.url}/og/home.jpg`} />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
  <link rel="icon" href={`${base}/icons/icon.svg`} type="image/svg+xml" />
  <meta name="theme-color" content="#050a08" />
</head>
<body class="lp" data-ga={site.ga4Id || undefined} data-base={base}>

<!-- The glowing jungle: a fixed backdrop behind the whole page (parallax as you scroll) -->
<div class="lp-hero__scene" id="scene" aria-hidden="true"></div>

<!-- Menu: fixed, stays on screen while scrolling -->
<header class="lp-head" id="head">
  <a href="#top" class="lp-head__logo" aria-label="MexiSol World">
    <Image src={lockup} alt="MexiSol World" width={150} densities={[1, 2]} loading="eager" />
  </a>
  <nav class="lp-head__nav" aria-label="On this page">
    <a href="#week">The week</a>
    <a href="#finca">The Finca</a>
    <a href="#dates">Dates</a>
    <a href="#reviews">Reviews</a>
    <a class="lp-pill" href={call} data-track="book_call">Book a free call</a>
  </nav>
</header>

<!-- ============ HERO: 3D walk into a glowing jungle at night ============ -->
<section class="lp-hero" id="top" aria-label="MexiSol World retreat in Jalisco">
  <div class="lp-hero__vignette" aria-hidden="true"></div>
  <div class="lp-ui lp-anim" id="ui">
    <div class="lp-hero__copy">
      <p class="lp-eyebrow lp-rise" style="--d:0ms">Tepatitlán, Jalisco · Mexico</p>
      <h1 class="lp-hero__title" aria-label="Come back to yourself.">
        {[["Come", "back"], ["to", "yourself."]].map((line, l) => (
          <span class="lp-line" aria-hidden="true">{line.map((w, i) => <span class="lp-w"><span style={`--d:${120 + (l * 2 + i) * 110}ms`}>{w}</span></span>)}</span>
        ))}
      </h1>
      <p class="lp-hero__cap lp-rise" style="--d:620ms">Seven days on a ranch in the highlands of Jalisco.<br />Up to 15 guests. All-inclusive from {usd(from)} USD.</p>
      <a class="lp-go lp-rise" style="--d:780ms" href="#who" id="go" aria-label="See the experience">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6" /></svg>
      </a>
    </div>
    <div class="lp-corner lp-rise" style="--d:900ms">
      <span>Move to wander</span><i></i>
      <button class="lp-sound" id="sound" type="button" aria-pressed="false" aria-label="Night sounds">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5v5h3.5L12 18V6L7.5 9.5Z" /><path class="w" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" /><path class="x" d="m16 10 4 4m0-4-4 4" /></svg>
      </button>
    </div>
  </div>
  <div class="lp-loader" id="loader" aria-hidden="true"><span></span></div>
</section>

<main id="main">

<!-- ============ IS A RETREAT RIGHT FOR YOU? (night, like the hero) ============ -->
<section class="lp-who lp-anim" id="who">
  <div class="lp-who__glow" aria-hidden="true"></div>
  <div class="lp-who__flies" aria-hidden="true">{Array.from({ length: 18 }, (_, i) => <i style={`--x:${(i * 37) % 100}%;--y:${(i * 53) % 100}%;--t:${6 + (i % 5) * 1.7}s;--o:${-(i * 0.9)}s`}></i>)}</div>
  <div class="lp-wrap lp-who__grid">
    <div class="lp-who__intro">
      <p class="lp-label lp-rise" style="--d:0ms">Who comes</p>
      <h2 class="lp-h2 lp-who__title" aria-label="Is a retreat right for you?">
        {['Is a retreat', 'right for you?'].map((line, l) => (
          <span class="lp-line" aria-hidden="true">{line.split(' ').map((w, i) => <span class="lp-w"><span style={`--d:${120 + (l * 3 + i) * 90}ms`}>{w}</span></span>)}</span>
        ))}
      </h2>
      <p class="lp-lead lp-rise" style="--d:700ms">Close to 400 people have joined us so far, most of them between 30 and 60 and most from the US. Different stories, one thing in common: they wanted a week that was about them.</p>
      <div class="lp-rise" style="--d:850ms"><div class="lp-who__photo" data-tilt><Photo name="guests-gathered-inside-the-osho-hut" alt="Guests gathered in a circle inside the Osho Hut" sizes="(max-width: 820px) 100vw, 40vw" /></div></div>
    </div>
    <ol class="lp-who__list">
      {forWho.map((f, i) => (
        <li class="lp-rise" style={`--d:${500 + i * 120}ms`}>
          <span class="lp-who__n">0{i + 1}</span>
          <div><h3 class="lp-h3">{f.title}</h3><p>{f.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ============ INTRO ============ -->
<section class="lp-intro" id="intro">
  <div class="lp-wrap lp-intro__grid">
    <div data-reveal>
      <p class="lp-label">The experience</p>
      <h2 class="lp-h2">A week away from the noise, with room to hear yourself again.</h2>
    </div>
    <div data-reveal>
      <p class="lp-lead">Finca El Péndulo is fourteen acres of agave, gardens and hand-built spaces, an hour from Guadalajara. For seven days, a group of up to 15 people steps out of ordinary life: ceremonies with live music, the heat of the temazcal, a fire under the stars, horses at sunrise and long dinners at one table.</p>
      <p class="lp-lead lp-muted">MexiSol World organizes the retreat and stays with you all week, from the airport to the last goodbye.</p>
      <div class="lp-actions">
        <a class="lp-btn" href={call} data-track="book_call">Book a free call</a>
        <a class="lp-btn lp-btn--ghost" href="#week">See the week</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ AERIAL VIDEO BAND ============ -->
<section class="lp-band" aria-label="The Finca from the air">
  <video class="lp-band__video" data-src={vid('aerial-finca.mp4')} poster={vid('aerial-finca.jpg')} muted loop playsinline preload="none"></video>
  <div class="lp-band__wash">
    <p class="lp-band__line" data-reveal>Fourteen acres. Fifteen spaces built by hand. Nine horses, two wolves and a sky full of stars.</p>
  </div>
</section>

<!-- ============ THE WEEK (videos) ============ -->
<section class="lp-week" id="week">
  <div class="lp-wrap">
    <div class="lp-head2" data-reveal>
      <p class="lp-label">What the week holds</p>
      <h2 class="lp-h2">Everything is included. All you bring is yourself.</h2>
    </div>
    <div class="lp-week__grid">
      {week.map((w, i) => (
        <article class={`lp-card${i === 0 || i === 9 ? ' lp-card--hero' : ''}`} data-reveal style={`--d:${(i % 3) * 90}ms`}>
          <div class="lp-card__media" data-tilt>
            {w.video
              ? <video data-src={vid(`${w.video}.mp4`)} poster={vid(`${w.video}.jpg`)} muted loop playsinline preload="none" aria-hidden="true"></video>
              : <Photo name={w.photo!} alt={w.title} sizes="(max-width: 820px) 100vw, 33vw" widths={[480, 800, 1200]} />}
            <span class="lp-card__n">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="lp-h3">{w.title}</h3>
          <p>{w.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ WHY HERE ============ -->
<section class="lp-why" id="why">
  <div class="lp-wrap">
    <div class="lp-head2" data-reveal>
      <p class="lp-label">Why MexiSol World</p>
      <h2 class="lp-h2">Small, personal, and done with care.</h2>
    </div>
    <div class="lp-why__grid">
      {why.map((w, i) => (
        <div class="lp-stat" data-reveal style={`--d:${i * 80}ms`}>
          <p class="lp-stat__n" data-count={w.n}>{w.n}</p>
          <p class="lp-stat__l">{w.label}</p>
