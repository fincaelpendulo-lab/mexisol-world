---
// Small newsletter banner shown above the footer on every page.
import Photo from './Photo.astro';
import SubscribeForm from './SubscribeForm.astro';
import rooms from '../data/rooms.json';

interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const off = `$${rooms.newsletterDiscountUsd} USD`;
const t = lang === 'es'
  ? { title: `${off} de descuento en tu retiro`, text: `Fechas y noticias de la Finca. Suscríbete y obtén ${off} de descuento al reservar. No se combina con el descuento por habitación compartida.`, button: 'Suscribirme' }
  : { title: `${off} off your retreat`, text: `Dates and news from the Finca. Sign up and get ${off} off when you book. It does not combine with the shared-room discount.`, button: 'Sign me up' };
---
<section class="nl-banner gutter" aria-labelledby="nl-banner-title">
  <div class="wrap nl-banner__inner">
    <Photo name="newsletter-greenhouse-lavender" alt="" sizes="(max-width: 760px) 100vw, 360px" widths={[400, 720]} class="nl-banner__photo" />
    <div class="nl-banner__text">
      <p class="label label--tight">Newsletter</p>
      <h2 id="nl-banner-title" class="t-title">{t.title}</h2>
      <p class="muted">{t.text}</p>
      <SubscribeForm list="newsletter" button={t.button} idPrefix="nl-banner" lang={lang} />
    </div>
  </div>
</section>

<style is:global>
  .nl-banner { padding-top: var(--space-8); padding-bottom: var(--space-8); border-top: 1px solid var(--hairline); }
  .nl-banner__inner { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: var(--space-7); align-items: center; }
  .nl-banner__photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .nl-banner__text { display: flex; flex-direction: column; gap: var(--space-3); max-width: 560px; }
  @media (max-width: 760px) {
    .nl-banner__inner { grid-template-columns: 1fr; gap: var(--space-5); }
    .nl-banner__photo { aspect-ratio: 16 / 9; }
  }
</style>
