---
// Photo band whose photo is the poster for a muted drone loop. The photo is the
// page's main image (loads first); site.js adds the video only on wide screens,
// with motion allowed and no data saver, and adds a pause button.
import Photo from './Photo.astro';
import { pageLang } from '../lib/i18n';

interface Props { poster: string; alt: string; mp4: string; webm?: string; height?: string; }
const { poster, alt, mp4, webm, height = '640px' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const es = pageLang(Astro.url) === 'es';
---
<div class="photo-band video-band" style={`--h:${height}`} data-video-band data-mp4={`${base}${mp4}`} data-webm={webm ? `${base}${webm}` : undefined}>
  <Photo name={poster} alt={alt} priority />
  <div class="photo-band__wash">
    <slot />
  </div>
  <button type="button" class="video-band__toggle" data-video-toggle hidden aria-label={es ? 'Pausar el video de fondo' : 'Pause the background video'}>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><rect class="i-pause" x="4" y="3" width="3" height="12"></rect><rect class="i-pause" x="11" y="3" width="3" height="12"></rect><path class="i-play" d="M5 3v12l10-6z"></path></svg>
  </button>
</div>

