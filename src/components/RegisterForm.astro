---
// Registration form. Posts to the Cloudflare Worker in worker/, which checks
// Turnstile and the fields again, then hands the lead to GoHighLevel.
import Button from './Button.astro';
import site from '../data/site.json';
import retreats from '../data/retreats.json';
import { dateRange, retreatDates } from '../lib/dates';
import { href, whatsappUrl } from '../lib/url';
import { pageLang, localize } from '../lib/i18n';
import { tr } from '../lib/retreats';

const lang = pageLang(Astro.url);
const es = lang === 'es';
const short = (title: string) => (es ? tr(title, 'es').replace(/^Retiro (de )?/, '').replace(/^\w/, (c) => c.toUpperCase()) : title.replace(/ retreat$/, ''));
const finca = retreats.finca.map((r) => ({ id: r.id, label: `${short(r.title)}, ${retreatDates(r.start, r.end, retreats.year, false, lang)}` }));
const intl = retreats.international.map((r) => ({ id: r.id, label: `${r.location === 'Europe' ? tr(r.title, lang) : tr(r.location, lang)}, ${dateRange(r.start, r.end, false, lang)}` }));
const t = es
  ? { name: 'Nombre completo', email: 'Correo electrónico', phoneHint: 'Con código de país. Opcional.', retreat: 'Retiro', atFinca: 'En Finca El Péndulo', intl: 'Internacionales', notSure: 'Aún no sé', notes: '¿Qué te trae aquí?', hp: 'Deja este campo vacío', submit: 'Solicitar un lugar', privacy: 'Usamos tus datos solo para contactarte sobre los retiros. Consulta nuestro', privacyLink: 'aviso de privacidad' }
  : { name: 'Full name', email: 'Email', phoneHint: 'With country code. Optional.', retreat: 'Retreat', atFinca: 'At Finca El Péndulo', intl: 'International', notSure: 'Not sure yet', notes: 'What brings you here?', hp: 'Leave this field empty', submit: 'Request a place', privacy: 'We use your details only to contact you about retreats. See our', privacyLink: 'privacy policy' };
---
<form class="register-form" action={site.formEndpoint || '#'} method="post" data-register-form data-whatsapp={whatsappUrl}>
  <div class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></div>

  <div class="field">
    <label for="f-name">{t.name}</label>
    <input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="f-name-error" data-validate />
    <p id="f-name-error" class="field__error"></p>
  </div>
  <div class="register-form__pair">
    <div class="field">
      <label for="f-email">{t.email}</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="f-email-error" data-validate />
      <p id="f-email-error" class="field__error"></p>
    </div>
    <div class="field">
      <label for="f-phone">WhatsApp</label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" pattern="\+?[0-9\s().\-]{7,20}" aria-describedby="f-phone-hint f-phone-error" data-validate />
      <p id="f-phone-hint" class="t-caption muted">{t.phoneHint}</p>
      <p id="f-phone-error" class="field__error"></p>
    </div>
  </div>
  <div class="field">
    <label for="f-retreat">{t.retreat}</label>
    <select id="f-retreat" name="retreat">
      <optgroup label={t.atFinca}>
        {finca.map((o) => <option value={o.id}>{o.label}</option>)}
      </optgroup>
      <optgroup label={t.intl}>
        {intl.map((o) => <option value={o.id}>{o.label}</option>)}
      </optgroup>
      <option value="not-sure">{t.notSure}</option>
    </select>
  </div>
  <div class="field">
    <label for="f-notes">{t.notes}</label>
    <textarea id="f-notes" name="message" rows="4" maxlength="2000"></textarea>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="f-website">{t.hp}</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_started" value="" />
  {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-theme="light" data-size="flexible"></div>}

  <div><Button type="submit" variant="primary">{t.submit}</Button></div>
  <p class="t-caption muted">{t.privacy} <a href={href(localize('/privacy', lang))}>{t.privacyLink}</a>.</p>
</form>

<style is:global>
  .register-form { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-5); }
  .register-form__pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: var(--space-5); }
  .cf-turnstile { min-height: 65px; }
</style>
