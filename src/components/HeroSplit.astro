---
// Design system HeroSplit: tall photo, overlapping card with the page's h1, two detail photos.
import Photo from './Photo.astro';
import { pageLang } from '../lib/i18n';
import Button from './Button.astro';

interface Thumb { name: string; alt: string; position?: string; }
interface Props {
  image: string;
  imageAlt: string;
  eyebrow?: string;
  title: string;
  cta?: { label: string; href: string };
  images?: Thumb[];
  video?: string;
  /** Extra photos that fade in after the main one (slideshow). */
  slides?: Thumb[];
}
const { image, imageAlt, eyebrow, title, cta, images = [], video, slides = [] } = Astro.props;
const es = pageLang(Astro.url) === 'es';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="ms-hero">
  <div class="ms-hero__photo video-band" data-video-band={video ? '' : undefined} data-mp4={video ? `${base}${video}` : undefined}>
    <Photo name={image} alt={imageAlt} priority sizes="(max-width: 760px) 100vw, 58vw" class="hero-slide is-active" />
    {slides.map((sl) => (
      <Photo name={sl.name} alt={sl.alt} sizes="(max-width: 760px) 100vw, 58vw" class="hero-slide" style={sl.position ? `object-position:${sl.position}` : undefined} />
    ))}
    {slides.length > 0 && (
      <button type="button" class="video-band__toggle" data-slides-toggle hidden aria-label={es ? 'Pausar las fotos' : 'Pause the slideshow'}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><rect class="i-pause" x="4" y="3" width="3" height="12"></rect><rect class="i-pause" x="11" y="3" width="3" height="12"></rect><path class="i-play" d="M5 3v12l10-6z"></path></svg>
      </button>
    )}
    {video && (
      <button type="button" class="video-band__toggle" data-video-toggle hidden aria-label={es ? 'Pausar el video de fondo' : 'Pause the background video'}>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><rect class="i-pause" x="4" y="3" width="3" height="12"></rect><rect class="i-pause" x="11" y="3" width="3" height="12"></rect><path class="i-play" d="M5 3v12l10-6z"></path></svg>
      </button>
    )}
  </div>
  <div class="ms-hero__side">
    <div class="ms-hero__card">
      {eyebrow && <p class="label">{eyebrow}</p>}
      <h1 class="ms-hero__title">{title}</h1>
      <p class="ms-hero__body"><slot /></p>
      {cta && <Button href={cta.href} variant="secondary">{cta.label}</Button>}
    </div>
    {images.length > 0 && (
      <div class="ms-hero__thumbs">
        {images.map((im) => (
          <Photo name={im.name} alt={im.alt} sizes="(max-width: 760px) 50vw, 20vw" widths={[400, 640, 900]} style={im.position ? `object-position:${im.position}` : undefined} />
        ))}
      </div>
    )}
  </div>
</section>
