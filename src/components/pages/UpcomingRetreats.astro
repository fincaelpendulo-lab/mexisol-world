---
// All upcoming retreats: a visual calendar, then every date grouped by season.
// Used by /upcoming-retreats and /es/proximos-retiros.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../Button.astro';
import RetreatCalendar from '../RetreatCalendar.astro';
import SubscribeForm from '../SubscribeForm.astro';
import retreats from '../../data/retreats.json';
import { upcoming, type Retreat } from '../../lib/retreats';
import { retreatDates } from '../../lib/dates';
import { monthName, localize, type Lang } from '../../lib/i18n';
import { href, absolute, registerHref } from '../../lib/url';
import { event, fincaLocation, placeIn } from '../../lib/schema';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const items = upcoming(lang);
const path = localize('/upcoming-retreats', lang);

// Seasons: Jan-Mar, Apr-Jun, Jul-Sep, Oct-Dec, by the month a retreat starts.
const periods: { key: string; label: string; items: Retreat[] }[] = [];
for (const r of items) {
  const y = +r.start.slice(0, 4);
  const q = Math.floor((+r.start.slice(5, 7) - 1) / 3);
  const key = `${y}-${q}`;
  let p = periods.find((x) => x.key === key);
  if (!p) {
    const from = monthName(q * 3, lang);
    const to = monthName(q * 3 + 2, lang);
    const label = es ? `${from.charAt(0).toUpperCase()}${from.slice(1)} a ${to} de ${y}` : `${from} to ${to} ${y}`;
    periods.push((p = { key, label, items: [] }));
  }
  p.items.push(r);
}

const kindLabel = es
  ? { ayahuasca: 'Ayahuasca', psilocybin: 'Psilocibina', finca: 'En la Finca', international: 'Internacional' }
  : { ayahuasca: 'Ayahuasca', psilocybin: 'Psilocybin', finca: 'At the Finca', international: 'International' };

const t = es
  ? {
      title: 'Próximos retiros y calendario 2026-2027 | MexiSol World',
      description: 'Todas las fechas de nuestros retiros de ayahuasca, psilocibina y bienestar en Finca El Péndulo, Jalisco, y de los retiros internacionales, en un solo calendario.',
      crumb: 'Próximos retiros',
      eyebrow: 'Calendario',
      h1: 'Próximos retiros',
      lead: 'Todas las fechas en un solo lugar: los retiros en Finca El Péndulo, en Jalisco, y los que hacemos en otros países.',
      seeCal: 'Ver el calendario',
      seeList: 'Ver la lista de fechas',
      calEyebrow: 'Mes a mes',
      calH2: 'Cuándo hay retiros',
      listEyebrow: 'Por temporada',
      listH2: 'Todas las fechas',
      book: 'Reservar',
      register: 'Regístrate',
      bookAria: (r: Retreat) => `Reservar ${r.title}, ${retreatDates(r.start, r.end, retreats.year, false, lang)}`,
      regAria: (r: Retreat) => `Regístrate para una llamada sobre ${r.title}, ${retreatDates(r.start, r.end, retreats.year, false, lang)}`,
      askH: '¿Aún no eliges fecha?',
      askP: `Te enviamos por correo el calendario completo de ${retreats.year}.`,
      askBtn: `Enviarme el calendario ${retreats.year}`,
      fincaBtn: 'Retiros en la Finca',
      intlBtn: 'Retiros internacionales',
    }
  : {
      title: 'Upcoming Retreats and Calendar 2026-2027 | MexiSol World',
      description: 'Every date for our ayahuasca, psilocybin and wellness retreats at Finca El Péndulo, Jalisco, and our international retreats, in one calendar.',
      crumb: 'Upcoming retreats',
      eyebrow: 'Calendar',
      h1: 'Upcoming retreats',
      lead: 'Every date in one place: the retreats at Finca El Péndulo in Jalisco, and the ones we lead in other countries.',
      seeCal: 'See the calendar',
      seeList: 'See the list of dates',
      calEyebrow: 'Month by month',
      calH2: 'When retreats are happening',
      listEyebrow: 'By season',
      listH2: 'All dates',
      book: 'Book',
      register: 'Register',
      bookAria: (r: Retreat) => `Book the ${r.title}, ${retreatDates(r.start, r.end, retreats.year)}`,
      regAria: (r: Retreat) => `Register for a call about the ${r.title}, ${retreatDates(r.start, r.end, retreats.year)}`,
      askH: 'Not ready to pick a date?',
      askP: `We will email you the full ${retreats.year} calendar.`,
      askBtn: `Send me the ${retreats.year} calendar`,
      fincaBtn: 'Finca El Péndulo retreats',
      intlBtn: 'International retreats',
    };

const intl = Object.fromEntries(retreats.international.map((r) => [r.id, r]));
const schema = items.map((r) => event({
  name: r.kind === 'international' ? `${r.title}, ${r.place}` : `${r.title}, Finca El Péndulo`,
  start: r.start,
  end: r.end,
  description: [r.note, r.place].filter(Boolean).join('. '),
  url: absolute(r.page.split('#')[0]),
  location: r.kind === 'international'
    ? placeIn(r.id === 'europe' ? 'Alicante, Spain' : intl[r.id].location, intl[r.id].country)
    : fincaLocation,
  bookingUrl: r.bookingUrl,
}));
---
<BaseLayout
  title={t.title}
  description={t.description}
  path={path}
  lang={lang}
  current="upcoming"
  ogImage="finca"
  breadcrumbs={[{ name: t.crumb, path }]}
  schema={schema}
>
  <section class="section" style="padding-bottom:var(--space-8);border-bottom:1px solid var(--hairline)">
    <div class="wrap">
      <p class="label" style="margin-bottom:var(--space-5)">{t.eyebrow}</p>
      <h1 class="t-display" style="margin-bottom:var(--space-5)">{t.h1}</h1>
      <p class="t-lead" style="max-width:var(--measure);margin-bottom:var(--space-7)">{t.lead}</p>
      <div class="cluster">
        <Button href="#calendar">{t.seeCal}</Button>
        <Button href="#dates">{t.seeList}</Button>
      </div>
    </div>
  </section>

  <section id="calendar" class="section">
    <div class="wrap">
      <p class="label" style="margin-bottom:var(--space-5)">{t.calEyebrow}</p>
      <h2 class="t-heading" style="margin-bottom:var(--space-6)">{t.calH2}</h2>
      <RetreatCalendar items={items} lang={lang} />
    </div>
  </section>

  <section id="dates" class="section section--top-rule">
    <div class="wrap">
      <p class="label" style="margin-bottom:var(--space-5)">{t.listEyebrow}</p>
      <h2 class="t-heading" style="margin-bottom:var(--space-7)">{t.listH2}</h2>
      {periods.map((p) => (
        <div class="period">
          <h3 class="t-title period__name">{p.label}</h3>
          <ul class="rule-list period__list">
            {p.items.map((r) => (
              <li>
                <p class="t-date period__date">{retreatDates(r.start, r.end, retreats.year, true, lang)}</p>
                <div class="period__what">
                  <a class="t-title period__title" href={href(r.page)}>{r.title}</a>
                  <p class="t-caption muted">{[r.kind === 'international' ? r.place : 'Finca El Péndulo', r.note].filter(Boolean).join(' · ')}</p>
                </div>
                <p class="t-caption period__kind"><span class:list={['cal__swatch', `cal--${r.kind}`]}></span>{kindLabel[r.kind]}</p>
                <span class="period__links">
                  {r.bookingUrl && <a href={r.bookingUrl} data-track="booking" aria-label={t.bookAria(r)}>{t.book}</a>}
                  <a href={registerHref(r.id, lang)} data-track="register" aria-label={t.regAria(r)}>{t.register}</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="rule-top rule-top--soft calendar-ask">
        <div><h3 class="t-title">{t.askH}</h3><p class="muted">{t.askP}</p></div>
        <SubscribeForm list="calendar" button={t.askBtn} idPrefix="cal-upcoming" lang={lang} />
      </div>
      <div class="cluster" style="margin-top:var(--space-8)">
        <Button href={href(localize('/finca-el-pendulo', lang))}>{t.fincaBtn}</Button>
        <Button href={href(localize('/international-retreats', lang))}>{t.intlBtn}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .period + .period { margin-top: var(--space-8); }
  .period__name { margin-bottom: var(--space-3); }
  .period__list > li { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; }
  .period__date { flex: 0 0 190px; }
  .period__what { flex: 1 1 280px; min-width: 0; }
  .period__title { color: var(--ink); text-decoration: none; }
  a.period__title:hover { color: var(--accent-text); }
  .period__kind { flex: 0 0 150px; display: inline-flex; align-items: center; gap: var(--space-2); }
  .period__kind .cal__swatch { width: 12px; height: 12px; display: inline-block; }
  .period__links { display: flex; gap: var(--space-5); }
  .period__links a { min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 760px) {
    .period__date { flex-basis: 100%; }
    .period__kind { flex-basis: auto; }
  }
</style>
