---
// The blog index for one language: /blog and /es/blog.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../Photo.astro';
import site from '../../data/site.json';
import { posts, postPath, readingTime, formatDate } from '../../lib/blog';
import { localize, type Lang } from '../../lib/i18n';
import { href, absolute } from '../../lib/url';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const list = await posts(lang);
const path = localize('/blog', lang);
const t = es
  ? { title: 'Blog sobre ayahuasca, psilocibina y retiros | MexiSol World', description: 'Guías claras sobre ayahuasca, psilocibina, Satori y cómo preparar un retiro de medicina en México, escritas por el equipo de Finca El Péndulo en Jalisco.', h1: 'Blog', lead: 'Guías sobre las medicinas, la preparación y la vida en Finca El Péndulo, escritas por quienes acompañan las ceremonias.', min: 'min de lectura', empty: 'Pronto publicaremos el primer artículo.', blogName: 'Blog de MexiSol World', rss: 'Suscríbete por RSS' }
  : { title: 'Ayahuasca, Psilocybin and Retreat Blog | MexiSol World', description: 'Clear guides to ayahuasca, psilocybin, Satori and preparing for a plant medicine retreat in Mexico, written by the team at Finca El Péndulo in Jalisco.', h1: 'Blog', lead: 'Guides to the medicines, preparing for a retreat and life at Finca El Péndulo, written by the people who hold the ceremonies.', min: 'min read', empty: 'The first post is on its way.', blogName: 'MexiSol World blog', rss: 'Follow by RSS' };

const schema = [{
  '@type': 'Blog',
  '@id': `${absolute(path)}#blog`,
  name: t.blogName,
  description: t.description,
  url: absolute(path),
  inLanguage: lang,
  publisher: { '@id': `${site.url}/#organization` },
  blogPost: list.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: absolute(postPath(p)),
    datePublished: p.data.date.toISOString().slice(0, 10),
    ...(p.data.updated ? { dateModified: p.data.updated.toISOString().slice(0, 10) } : {}),
  })),
}];
const [first, ...rest] = list;
---
<BaseLayout title={t.title} description={t.description} path={path} lang={lang} current="blog" breadcrumbs={[{ name: 'Blog', path }]} schema={schema}>
  <section class="section" style="padding-bottom:var(--space-8);border-bottom:1px solid var(--hairline)">
    <div class="wrap">
      <p class="label" style="margin-bottom:var(--space-5)">MexiSol World</p>
      <h1 class="t-display" style="margin-bottom:var(--space-5)">{t.h1}</h1>
      <p class="t-lead" style="max-width:var(--measure)">{t.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {!first && <p class="muted">{t.empty}</p>}
      {first && (
        <article class="post-feature">
          <a href={href(postPath(first))} class="post-feature__photo" tabindex="-1" aria-hidden="true">
            <Photo name={first.data.image} alt="" sizes="(max-width: 760px) 100vw, 55vw" widths={[480, 800, 1200]} priority class="ratio-3-2" />
          </a>
          <div class="post-feature__text">
            <p class="t-caption muted"><time datetime={first.data.date.toISOString().slice(0, 10)}>{formatDate(first.data.date, lang)}</time> · {readingTime(first)} {t.min}</p>
            <h2 class="t-heading"><a href={href(postPath(first))} class="post-link">{first.data.title}</a></h2>
            <p class="muted">{first.data.description}</p>
          </div>
        </article>
      )}
      {rest.length > 0 && (
        <ul class="post-grid">
          {rest.map((p) => (
            <li>
              <article class="stack" style="--stack:var(--space-3)">
                <a href={href(postPath(p))} tabindex="-1" aria-hidden="true"><Photo name={p.data.image} alt="" sizes="(max-width: 760px) 100vw, 33vw" widths={[400, 640, 900]} class="ratio-3-2" /></a>
                <p class="t-caption muted" style="margin-top:var(--space-3)"><time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date, lang)}</time> · {readingTime(p)} {t.min}</p>
                <h2 class="t-title"><a href={href(postPath(p))} class="post-link">{p.data.title}</a></h2>
                <p class="muted">{p.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      )}
      <p class="t-caption" style="margin-top:var(--space-8)"><a href={href(`${es ? '/es' : ''}/rss.xml`)}>{t.rss}</a></p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .post-link { color: var(--ink); text-decoration: none; }
  .post-link:hover { color: var(--accent-text); text-decoration: underline; }
  .post-feature { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-7); align-items: center; padding-bottom: var(--space-8); border-bottom: 1px solid var(--hairline); }
  .post-feature__text { display: flex; flex-direction: column; gap: var(--space-4); }
  .post-grid { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--space-8) var(--space-6); }
  @media (max-width: 760px) {
    .post-feature { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
